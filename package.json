{
  "name": "remotion-claude",
  "version": "1.0.0",
  "description": "Anúncio Corso Automação (Remotion)",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/google-fonts": "4.0.529",
    "@remotion/media": "4.0.529",
    "@remotion/paths": "4.0.529",
    "@remotion/tailwind-v4": "4.0.529",
    "@remotion/transitions": "4.0.529",
    "lucide-react": "^1.48.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.529",
    "tailwindcss": "4.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.529",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render:dor": "remotion render Anuncio-Dor out/anuncio-dor.mp4 --codec h264 --crf 18",
    "render:pergunta": "remotion render Anuncio-Pergunta out/anuncio-pergunta.mp4 --codec h264 --crf 18",
    "render:feed": "remotion render Anuncio-Feed out/anuncio-feed.mp4 --codec h264 --crf 18",
    "render:treino": "remotion render Treino-Segunda out/treino-segunda.mp4 --codec h264 --crf 18",
    "render:treino-16x9": "remotion render Treino-Segunda-16x9 out/treino-segunda-16x9.mp4 --codec h264 --crf 18",
    "render:dono": "remotion render Anuncio-Dono out/anuncio-dono.mp4 --codec h264 --crf 18",
    "render:dono-feed": "remotion render Anuncio-Dono-Feed out/anuncio-dono-feed.mp4 --codec h264 --crf 18",
    "render:barbearia": "remotion render Barbearia out/barbearia.mp4 --codec h264 --crf 18",
    "render:barbearia-feed": "remotion render Barbearia-Feed out/barbearia-feed.mp4 --codec h264 --crf 18",
    "render:manual": "remotion render ManualPintura out/manual-pintura.mp4 --codec h264 --crf 18",
    "capa:manual": "remotion still ManualPintura out/capa.png --frame=1150",
    "render:audio-dor": "remotion render Anuncio-Dor out/anuncio-dor-audio.mp3 --codec mp3",
    "render:audio-pergunta": "remotion render Anuncio-Pergunta out/anuncio-pergunta-audio.mp3 --codec mp3",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
